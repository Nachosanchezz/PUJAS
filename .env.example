# Copia este archivo como .env.local y rellena los valores.
# Están en Supabase → Settings → API Keys (o en el botón "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
# Supabase → Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_...
# Contraseña del panel /admin (larga y difícil de adivinar)
ADMIN_PASSWORD=
# Firma las sesiones de los presidentes. Genera uno con: openssl rand -base64 32
SESSION_SECRET=
